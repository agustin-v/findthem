GEO_HOST=0.0.0.0
GEO_PORT=8000
GEO_CORS_ORIGINS=["http://localhost:5173"]
GEO_OSM_CACHE_DIR=.cache/osm
GEO_OSM_CACHE_TTL_HOURS=24
GEO_DEFAULT_H3_RESOLUTION=9
GEO_MIN_SEGMENT_AREA_M2=500.0

# Shared secret gating POST /api/v1/segments/generate — apps/api sends it as
# X-Internal-Token (see apps/api/.env.example's GEO_INTERNAL_TOKEN). Leave
# unset for local dev; the check is a no-op when this is empty.
GEO_INTERNAL_TOKEN=
