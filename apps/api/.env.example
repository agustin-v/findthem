# All optional in dev (sensible defaults in config/runtime.exs); DATABASE_URL and
# SECRET_KEY_BASE are required in prod (see config/runtime.exs).

# ecto://USER:PASS@HOST/DATABASE — required in prod
DATABASE_URL=

PORT=4000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Generate with `mix phx.gen.secret` — required in prod
SECRET_KEY_BASE=

# Clerk JWT verification (Epic #2) — issuer/authorized parties aren't secret;
# defaults in config/runtime.exs point at the FindThem dev Clerk instance
CLERK_ISSUER=https://polished-grizzly-42.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Geo service proxy — shared secret gate, browser never talks to geo directly
GEO_URL=http://localhost:8000
GEO_INTERNAL_TOKEN=

# R2 subject-photo storage (Story 27) — not wired up yet
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
